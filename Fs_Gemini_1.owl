First Attempt

@prefix : http://example.org/panthera# . @prefix mlt: http://example.org/mlt# . @prefix rdf: http://www.w3.org/1999/02/22-rdf-syntax-ns# . @prefix rdfs: http://www.w3.org/2000/01/rdf-schema# . @prefix owl: http://www.w3.org/2002/07/owl# .
#################################################################
Classes
#################################################################
:TaxonomicRank rdf:type owl:Class .
:GenusType rdf:type owl:Class .
:SpeciesType rdf:type owl:Class .
:Organism rdf:type owl:Class .
:Genus rdf:type owl:Class .
:Species rdf:type owl:Class .
:Panthera rdf:type owl:Class .
:PantheraLeo rdf:type owl:Class .
:PantheraTigris rdf:type owl:Class .
:PantheraOnca rdf:type owl:Class .
mlt:1stOrderClass rdf:type owl:Class .
mlt:2ndOrderClass rdf:type owl:Class .
mlt:3rdOrderClass rdf:type owl:Class .
mlt:TokenIndividual rdf:type owl:Class .
#################################################################
Object Properties
#################################################################
mlt:isSubordinateOf rdf:type owl:ObjectProperty . mlt:isPowertypeOf rdf:type owl:ObjectProperty . mlt:isCharacterizationOf rdf:type owl:ObjectProperty .
#################################################################
Axioms
#################################################################
mlt:3rdOrderClass mlt:isPowertypeOf mlt:2ndOrderClass ; mlt:isCharacterizationOf mlt:2ndOrderClass ; mlt:isSubordinationOf mlt:3rdOrderClass .
mlt:2ndOrderClass mlt:isPowertypeOf mlt:1stOrderClass ; mlt:isCharacterizationOf mlt:1stOrderClass ; mlt:isSubordinationOf mlt:2ndOrderClass .
:TaxonomicRank rdf:type mlt:2ndOrderClass ; mlt:isPowertypeOf :Organism .
:GenusType rdf:type mlt:2ndOrderClass ; rdfs:subClassOf :TaxonomicRank ; mlt:isCharacterizationOf :Organism .
:SpeciesType rdf:type mlt:2ndOrderClass ; rdfs:subClassOf :TaxonomicRank ; mlt:isSubordinateOf :GenusType .
:Organism rdf:type mlt:1stOrderClass .
:Genus rdf:type :GenusType ; rdf:type mlt:1stOrderClass ; rdfs:subClassOf :Organism .
:Species rdf:type :SpeciesType ; rdf:type mlt:1stOrderClass ; rdfs:subClassOf :Organism .
:Panthera rdf:type :GenusType ; rdf:type mlt:1stOrderClass ; rdfs:subClassOf :Organism .
:PantheraLeo rdf:type :SpeciesType ; rdf:type mlt:1stOrderClass ; rdfs:subClassOf :Panthera .
:PantheraTigris rdf:type :SpeciesType ; rdf:type mlt:1stOrderClass ; rdfs:subClassOf :Panthera .
:PantheraOnca rdf:type :SpeciesType ; rdf:type mlt:1stOrderClass ; rdfs:subClassOf :Panthera .
#################################################################
Individuals
#################################################################
:Simba rdf:type owl:NamedIndividual ; rdf:type :PantheraLeo .
:Raja rdf:type owl:NamedIndividual ; rdf:type :PantheraTigris .


