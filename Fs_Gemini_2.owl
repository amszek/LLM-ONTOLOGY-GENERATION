First Attempt

@prefix : http://example.org/Company# . @prefix mlt: http://example.org/mlt# . @prefix rdf: http://www.w3.org/1999/02/22-rdf-syntax-ns# . @prefix rdfs: http://www.w3.org/2000/01/rdf-schema# . @prefix owl: http://www.w3.org/2002/07/owl# .
http://example.org/Company rdf:type owl:Ontology .
#################################################################
Classes
#################################################################
mlt:1stOrderClass rdf:type owl:Class . mlt:2ndOrderClass rdf:type owl:Class . mlt:3rdOrderClass rdf:type owl:Class . mlt:TokenIndividual rdf:type owl:Class .
:OrganizationalClassificationType rdf:type owl:Class .
:BusinessRole rdf:type owl:Class . :ManagementRole rdf:type owl:Class . :EmployeeType rdf:type owl:Class .
:Employee rdf:type owl:Class . :Programmer rdf:type owl:Class . :SoftwareDesigner rdf:type owl:Class . :DatabaseDesigner rdf:type owl:Class . :Manager rdf:type owl:Class . :Director rdf:type owl:Class .
#################################################################
Object Properties
#################################################################
mlt:isSubordinateOf rdf:type owl:ObjectProperty . mlt:isPowertypeOf rdf:type owl:ObjectProperty . mlt:isCharacterizationOf rdf:type owl:ObjectProperty .
#################################################################
Axioms
#################################################################
mlt:3rdOrderClass mlt:isPowertypeOf mlt:2ndOrderClass ; mlt:isCharacterizationOf mlt:2ndOrderClass .
mlt:2ndOrderClass mlt:isPowertypeOf mlt:1stOrderClass ; mlt:isCharacterizationOf mlt:1stOrderClass .
:BusinessRole rdf:type mlt:2ndOrderClass ; rdf:type :OrganizationalClassificationType ; mlt:isCharacterizationOf :Employee .
:ManagementRole rdf:type mlt:2ndOrderClass ; rdf:type :OrganizationalClassificationType ; mlt:isCharacterizationOf :Employee .
:EmployeeType rdf:type mlt:2ndOrderClass ; rdf:type :OrganizationalClassificationType ; mlt:isCharacterizationOf :Employee .
:Employee rdf:type mlt:1stOrderClass ; rdfs:subClassOf mlt:TokenIndividual .
:Programmer rdf:type :EmployeeType ; rdf:type mlt:1stOrderClass ; rdfs:subClassOf :Employee .
:SoftwareDesigner rdf:type :BusinessRole ; rdf:type mlt:1stOrderClass ; rdfs:subClassOf :Employee .
:DatabaseDesigner rdf:type :BusinessRole ; rdf:type mlt:1stOrderClass ; rdfs:subClassOf :Employee .
:Manager rdf:type :ManagementRole ; rdf:type mlt:1stOrderClass ; rdfs:subClassOf :Employee .
:Director rdf:type :ManagementRole ; rdf:type mlt:1stOrderClass ; rdfs:subClassOf :Employee ; mlt:isSubordinateOf :Manager .






Second Attempt

@prefix : http://example.org/Company# . @prefix mlt: http://example.org/mlt# . @prefix rdf: http://www.w3.org/1999/02/22-rdf-syntax-ns# . @prefix rdfs:http://www.w3.org/2000/01/rdf-schema# . @prefix owl: http://www.w3.org/2002/07/owl# .
#################################################################
Classes
#################################################################
:OrganizationalClassification rdf:type owl:Class . :EmployeeType rdf:type owl:Class . :BusinessRole rdf:type owl:Class . :ManagementRole rdf:type owl:Class . :Employee rdf:type owl:Class . :Programmer rdf:type owl:Class . :SoftwareDesigner rdf:type owl:Class . :DatabaseDesigner rdf:type owl:Class . :Manager rdf:type owl:Class . :Director rdf:type owl:Class .
mlt:1stOrderClass rdf:type owl:Class . mlt:2ndOrderClass rdf:type owl:Class . mlt:3rdOrderClass rdf:type owl:Class . mlt:TokenIndividual rdf:type owl:Class .
#################################################################
Object Properties
#################################################################
mlt:isSubordinateOf rdf:type owl:ObjectProperty . mlt:isPowertypeOf rdf:type owl:ObjectProperty . mlt:isCharacterizationOf rdf:type owl:ObjectProperty .
#################################################################
Axioms
#################################################################
mlt:3rdOrderClass mlt:isPowertypeOf mlt:2ndOrderClass ; mlt:isCharacterizationOf mlt:2ndOrderClass ; mlt:isSubordinateOf mlt:3rdOrderClass .
mlt:2ndOrderClass mlt:isPowertypeOf mlt:1stOrderClass ; mlt:isCharacterizationOf mlt:1stOrderClass ; mlt:isSubordinateOf mlt:2ndOrderClass .
:EmployeeTypeType rdf:type mlt:3rdOrderClass ; mlt:isPowertypeOf :EmployeeType .
:BusinessRoleType rdf:type mlt:3rdOrderClass ; mlt:isPowertypeOf :BusinessRole .
:ManagementRoleType rdf:type mlt:3rdOrderClass ; mlt:isPowertypeOf :ManagementRole .
:EmployeeType rdf:type mlt:2ndOrderClass ; rdf:type :OrganizationalClassification .
:BusinessRole rdf:type mlt:2ndOrderClass ; rdf:type :OrganizationalClassification ; mlt:isSubordinateOf :EmployeeType .
:ManagementRole rdf:type mlt:2ndOrderClass ; rdf:type :OrganizationalClassification ; mlt:isSubordinateOf :BusinessRole .
:Employee rdf:type mlt:1stOrderClass ; rdf:type :EmployeeType ; rdfs:subClassOf mlt:TokenIndividual .
:Programmer rdf:type :BusinessRole ; rdfs:subClassOf :Employee .
:SoftwareDesigner rdf:type :BusinessRole ; rdfs:subClassOf :Employee ; mlt:isCharacterizationOf :Programmer .
:DatabaseDesigner rdf:type :BusinessRole ; rdfs:subClassOf :Employee .
:Manager rdf:type :ManagementRole ; rdfs:subClassOf :Employee ; mlt:isCharacterizationOf :Employee .
:Director rdf:type :ManagementRole ; rdfs:subClassOf :Employee ; mlt:isCharacterizationOf :Manager .
#################################################################
Individual
#################################################################
:John rdf:type owl:NamedIndividual ; rdf:type :Programmer .
:Alice rdf:type owl:NamedIndividual ; rdf:type :Director .

