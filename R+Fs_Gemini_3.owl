    rdfs:subPropertyOf mlt:crossLevelProperty .

mlt:isPowertypeOf
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:crossLevelProperty .

:PersonType
    rdf:type owl:Class .

:PersonTypeByGender
    rdf:type owl:Class .

:EmployeeType
