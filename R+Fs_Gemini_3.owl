:EmployeeRoleTypeByGender
    rdf:type owl:Class .

:Person
    rdf:type owl:Class .

:Woman
    rdf:type owl:Class .

:Man
    rdf:type owl:Class .

:Manager
    rdf:type owl:Class .

:Researcher
    rdf:type owl:Class .

:FemaleManager
    rdf:type owl:Class .

:MaleManager
    rdf:type owl:Class .

:PersonTypeType
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf :PersonType .

:EmployeeTypeType
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf :EmployeeType .

:PersonType
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf mlt:1stOrderClass ;
    mlt:isCharacterizationOf :Person .

:PersonTypeByGender
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf mlt:1stOrderClass ;
    mlt:isSubordinateOf :PersonType ;
    mlt:isCharacterizationOf :Person .

:EmployeeType
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf mlt:1stOrderClass ;
