org:SoftwareDesignerInstance org:hasType org:EmployeeTypeInstance .
org:DatabaseDesignerInstance org:hasType org:EmployeeTypeInstance .
org:ManagerInstance org:hasRole org:ManagementRoleInstance .
org:DirectorInstance org:hasRole org:ManagementRoleInstance .
org:ManagerInstance org:hasEmployee org:ProgrammerInstance .
org:ManagerInstance org:hasEmployee org:SoftwareDesignerInstance .
org:ManagerInstance org:hasEmployee org:DatabaseDesignerInstance .
org:DirectorInstance org:hasManager org:ManagerInstance .
org:ManagerInstance org:hasManager org:DirectorInstance .
org:DirectorInstance org:hasSubordinate org:ManagerInstance .
org:ProgrammerInstance org:hasManager org:ManagerInstance .
org:SoftwareDesignerInstance org:hasManager org:ManagerInstance .
org:DatabaseDesignerInstance org:hasManager org:ManagerInstance .
org:BusinessRole owl:equivalentClass org:ManagementRole .
org:EmployeeType owl:equivalentClass org:Employee .
org:Programmer owl:disjointWith org:SoftwareDesigner .
org:SoftwareDesigner owl:disjointWith org:DatabaseDesigner .
org:Programmer owl:disjointWith org:DatabaseDesigner .
org:Manager owl:disjointWith org:Programmer .
org:Manager owl:disjointWith org:SoftwareDesigner .
org:Manager owl:disjointWith org:DatabaseDesigner .
org:Director owl:disjointWith org:Programmer .
org:Director owl:disjointWith org:SoftwareDesigner .
org:Director owl:disjointWith org:DatabaseDesigner .

