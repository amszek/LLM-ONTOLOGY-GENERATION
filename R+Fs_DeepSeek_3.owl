First Attempt

@prefix : <http://example.org/PersonTaxonomy#> .
@prefix mlt: <http://example.org/mlt#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .


mlt:TokenIndividual rdf:type owl:Class .


mlt:1stOrderClass
    rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .


mlt:2ndOrderClass
    rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .


mlt:3rdOrderClass
    rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .


mlt:intraLevelProperty rdf:type owl:ObjectProperty .


mlt:crossLevelProperty rdf:type owl:ObjectProperty .


mlt:isSubordinateOf
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:intraLevelProperty .


mlt:isCharacterizationOf
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:crossLevelProperty .


mlt:isPowertypeOf
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:crossLevelProperty .


:PersonType rdf:type owl:Class .


:PersonTypeByGender rdf:type owl:Class .


:EmployeeType rdf:type owl:Class .


:EmployeeRoleTypeByGender rdf:type owl:Class .


:Person rdf:type owl:Class .


:Woman rdf:type owl:Class .


:Man rdf:type owl:Class .


:Manager rdf:type owl:Class .


:Researcher rdf:type owl:Class .


:FemaleManager rdf:type owl:Class .


:MaleManager rdf:type owl:Class .


:PersonTypeType
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf :PersonType .


:PersonTypeByGenderType
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf :PersonTypeByGender .


:EmployeeTypeType
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf :EmployeeType .


:EmployeeRoleTypeByGenderType
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf :EmployeeRoleTypeByGender .


:PersonType
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf mlt:1stOrderClass ;
    mlt:isCharacterizationOf :Person .


:PersonTypeByGender
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf mlt:1stOrderClass ;
    mlt:isSubordinateOf :PersonType ;
    mlt:isCharacterizationOf :Person .


:EmployeeType
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf mlt:1stOrderClass ;
    mlt:isSubordinateOf :PersonType ;
    mlt:isCharacterizationOf :Person .


:EmployeeRoleTypeByGender
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf mlt:1stOrderClass ;
    mlt:isSubordinateOf :EmployeeType ;
    mlt:isSubordinateOf :PersonTypeByGender ;
    mlt:isCharacterizationOf :Person .


:Person
    rdf:type mlt:1stOrderClass ;
    rdfs:subClassOf mlt:TokenIndividual .


:Woman
    rdf:type :PersonTypeByGender ;
    rdfs:subClassOf :Person .


:Man
    rdf:type :PersonTypeByGender ;
    rdfs:subClassOf :Person .


:Manager
    rdf:type :EmployeeType ;
    rdfs:subClassOf :Person .


:Researcher
    rdf:type :EmployeeType ;
    rdfs:subClassOf :Person .


:FemaleManager
    rdf:type :EmployeeRoleTypeByGender ;
    rdfs:subClassOf :Manager ;
    rdfs:subClassOf :Woman ;
    mlt:isCharacterizationOf :Manager .


:MaleManager
    rdf:type :EmployeeRoleTypeByGender ;
    rdfs:subClassOf :Manager ;
    rdfs:subClassOf :Man ;
    mlt:isCharacterizationOf :Manager .


:Ana
    rdf:type mlt:TokenIndividual ;
    rdf:type :Woman ;
    rdf:type :FemaleManager .


:Bob
    rdf:type mlt:TokenIndividual ;
    rdf:type :Man ;
    rdf:type :MaleManager .








Second Attempt
@prefix :    <http://example.org/PersonTaxonomy#> .
@prefix mlt: <http://example.org/mlt#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:<http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/PersonTaxonomy>
    rdf:type owl:Ontology .

#################################################################
# MLT Basic Types
#################################################################

mlt:TokenIndividual
    rdf:type owl:Class .

mlt:1stOrderClass
    rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

mlt:2ndOrderClass
    rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

mlt:3rdOrderClass
    rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

#################################################################
# MLT Properties
#################################################################

mlt:intraLevelProperty
    rdf:type owl:ObjectProperty .

mlt:crossLevelProperty
    rdf:type owl:ObjectProperty .

mlt:isSubordinateOf
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:intraLevelProperty .

mlt:isCharacterizationOf
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:crossLevelProperty .

mlt:isPowertypeOf
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:crossLevelProperty .

#################################################################
# Domain Classes
#################################################################

:PersonType
    rdf:type owl:Class .

:PersonTypeByGender
    rdf:type owl:Class .

:EmployeeType
    rdf:type owl:Class .

:EmployeeRoleTypeByGender
    rdf:type owl:Class .

:Person
    rdf:type owl:Class .

:Woman
    rdf:type owl:Class .

:Man
    rdf:type owl:Class .

:Manager
    rdf:type owl:Class .

:Researcher
    rdf:type owl:Class .

:FemaleManager
    rdf:type owl:Class .

:MaleManager
    rdf:type owl:Class .

#################################################################
# Higher-Order Classification Types (Powertypes)
#################################################################

:PersonType
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf :Person .

:PersonTypeByGender
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf :Woman , :Man .

:EmployeeType
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf :Manager , :Researcher .

:EmployeeRoleTypeByGender
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf :FemaleManager , :MaleManager .

#################################################################
# Second-Order Classes
#################################################################

:Person
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf mlt:1stOrderClass .

:Woman
    rdf:type mlt:2ndOrderClass ;
    rdf:type :PersonTypeByGender ;
    rdfs:subClassOf :Person ;
    mlt:isSubordinateOf :Person .

:Man
    rdf:type mlt:2ndOrderClass ;
    rdf:type :PersonTypeByGender ;
    rdfs:subClassOf :Person ;
    mlt:isSubordinateOf :Person .

:Manager
    rdf:type mlt:2ndOrderClass ;
    rdf:type :EmployeeType ;
    rdfs:subClassOf :Person ;
    mlt:isSubordinateOf :Person ;
    mlt:isCharacterizationOf :Person .

:Researcher
    rdf:type mlt:2ndOrderClass ;
    rdf:type :EmployeeType ;
    rdfs:subClassOf :Person ;
    mlt:isSubordinateOf :Person ;
    mlt:isCharacterizationOf :Person .

#################################################################
# Intersection / Role Classes (Second-Order)
#################################################################

:FemaleManager
    rdf:type mlt:2ndOrderClass ;
    rdf:type :EmployeeRoleTypeByGender ;
    rdfs:subClassOf :Woman , :Manager ;
    mlt:isSubordinateOf :Manager ;
    mlt:isSubordinateOf :Woman ;
    mlt:isCharacterizationOf :Person .

:MaleManager
    rdf:type mlt:2ndOrderClass ;
    rdf:type :EmployeeRoleTypeByGender ;
    rdfs:subClassOf :Man , :Manager ;
    mlt:isSubordinateOf :Manager ;
    mlt:isSubordinateOf :Man ;
    mlt:isCharacterizationOf :Person .

#################################################################
# First-Order Classes
#################################################################

:PersonClass
    rdf:type mlt:1stOrderClass ;
    rdfs:subClassOf mlt:TokenIndividual .

#################################################################
# Token Individuals
#################################################################

:Ana
    rdf:type mlt:TokenIndividual ;
    rdf:type :Woman ;
    rdf:type :FemaleManager .

:Bob
    rdf:type mlt:TokenIndividual ;
    rdf:type :Man ;
    rdf:type :MaleManager .


