First Attempt

@prefix :      <http://example.org/panthera#> .
@prefix mlt:   <http://example.org/mlt#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

#################################################################
# MLT Basic Types
#################################################################

mlt:TokenIndividual rdf:type owl:Class .

mlt:1stOrderClass rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

mlt:2ndOrderClass rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

mlt:3rdOrderClass rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

#################################################################
# MLT Properties
#################################################################

mlt:intraLevelProperty rdf:type owl:ObjectProperty .
mlt:crossLevelProperty rdf:type owl:ObjectProperty .

mlt:isSubordinateOf rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:intraLevelProperty .

mlt:isPowertypeOf rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:crossLevelProperty .

mlt:isCharacterizationOf rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:crossLevelProperty .

#################################################################
# Relationships Between MLT Basic Types
#################################################################

mlt:1stOrderClass rdf:type mlt:2ndOrderClass ;
    mlt:isPowertypeOf mlt:TokenIndividual .

mlt:2ndOrderClass rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf mlt:1stOrderClass .

#################################################################
# Axioms
#################################################################

:TaxonomicRankType rdf:type mlt:2ndOrderClass ;
    mlt:isPowertypeOf :TaxonomicRank .

:TaxonomicRank rdf:type mlt:1stOrderClass ;
    rdfs:subClassOf mlt:TokenIndividual .

:GenusType rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf :TaxonomicRankType ;
    mlt:isCharacterizationOf :TaxonomicRank .

:SpeciesType rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf :TaxonomicRankType ;
    mlt:isCharacterizationOf :TaxonomicRank .

:Genus rdf:type mlt:1stOrderClass,
              rdf:type :GenusType ;
    rdfs:subClassOf :TaxonomicRank .

:Species rdf:type mlt:1stOrderClass,
               rdf:type :SpeciesType ;
    rdfs:subClassOf :TaxonomicRank .

:PantheraGenusType rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf :GenusType ;
    mlt:isCharacterizationOf :Genus .

:PantheraSpeciesType rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf :SpeciesType ;
    mlt:isSubordinateOf :PantheraGenusType ;
    mlt:isCharacterizationOf :Species .

:OrganismType rdf:type mlt:2ndOrderClass ;
    mlt:isPowertypeOf :Organism .

:Organism rdf:type mlt:1stOrderClass ;
    rdfs:subClassOf mlt:TokenIndividual .

:Panthera rdf:type mlt:1stOrderClass,
                rdf:type :PantheraGenusType ;
    rdfs:subClassOf :Genus .

:PantheraLeo rdf:type mlt:1stOrderClass,
                   rdf:type :PantheraSpeciesType ;
    rdfs:subClassOf :Species, :Organism .

:PantheraTigris rdf:type mlt:1stOrderClass,
                      rdf:type :PantheraSpeciesType ;
    rdfs:subClassOf :Species, :Organism .

:PantheraOnca rdf:type mlt:1stOrderClass,
                    rdf:type :PantheraSpeciesType ;
    rdfs:subClassOf :Species, :Organism .

#################################################################
# Token Individuals
#################################################################

:LeoSpecimen rdf:type mlt:TokenIndividual,
                      :PantheraLeo .

:TigrisSpecimen rdf:type mlt:TokenIndividual,
                         :PantheraTigris .

:OncaSpecimen rdf:type mlt:TokenIndividual,
                       :PantheraOnca .




Second Attempt
@prefix :      <http://example.org/panthera#> .
@prefix mlt:   <http://example.org/mlt#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

#################################################################
# MLT Basic Types
#################################################################

mlt:TokenIndividual rdf:type owl:Class .

mlt:1stOrderClass rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

mlt:2ndOrderClass rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

mlt:3rdOrderClass rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

#################################################################
# MLT Properties
#################################################################

mlt:intraLevelProperty rdf:type owl:ObjectProperty .
mlt:crossLevelProperty rdf:type owl:ObjectProperty .

mlt:isSubordinateOf rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:intraLevelProperty .

mlt:isPowertypeOf rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:crossLevelProperty .

mlt:isCharacterizationOf rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:crossLevelProperty .

#################################################################
# Relationships Between MLT Basic Types
#################################################################

mlt:1stOrderClass rdf:type mlt:2ndOrderClass ;
    mlt:isPowertypeOf mlt:TokenIndividual .

mlt:2ndOrderClass rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf mlt:1stOrderClass .

#################################################################
# Taxonomic Rank Hierarchy
#################################################################

:TaxonomicRank rdf:type mlt:2ndOrderClass ;
    mlt:isPowertypeOf :Taxon .

:GenusType rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf :TaxonomicRank ;
    mlt:isCharacterizationOf :Taxon ;
    mlt:isPowertypeOf :Genus .

:SpeciesType rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf :TaxonomicRank ;
    mlt:isCharacterizationOf :Taxon ;
    mlt:isPowertypeOf :Species .

:GenusRankType rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf :TaxonomicRank ;
    mlt:isSubordinateOf :TaxonomicRank .

:SpeciesRankType rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf :TaxonomicRank ;
    mlt:isSubordinateOf :TaxonomicRank .

#################################################################
# First-Order Classes
#################################################################

:Taxon rdf:type mlt:1stOrderClass ;
    rdfs:subClassOf mlt:TokenIndividual .

:Genus rdf:type mlt:1stOrderClass,
              rdf:type :GenusType ;
    rdfs:subClassOf :Taxon .

:Species rdf:type mlt:1stOrderClass,
               rdf:type :SpeciesType ;
    rdfs:subClassOf :Taxon .

:Organism rdf:type mlt:1stOrderClass ;
    rdfs:subClassOf mlt:TokenIndividual .

:Panthera rdf:type mlt:1stOrderClass,
               rdf:type :GenusType ;
    rdfs:subClassOf :Genus .

:PantheraLeo rdf:type mlt:1stOrderClass,
                  rdf:type :SpeciesType ;
    rdfs:subClassOf :Species ;
    mlt:isSubordinateOf :Panthera .

:PantheraTigris rdf:type mlt:1stOrderClass,
                     rdf:type :SpeciesType ;
    rdfs:subClassOf :Species ;
    mlt:isSubordinateOf :Panthera .

:PantheraOnca rdf:type mlt:1stOrderClass,
                   rdf:type :SpeciesType ;
    rdfs:subClassOf :Species ;
    mlt:isSubordinateOf :Panthera .

#################################################################
# Token Individuals
#################################################################

:LeoSpecimen rdf:type mlt:TokenIndividual,
                      :PantheraLeo .

:TigerSpecimen rdf:type mlt:TokenIndividual,
                      :PantheraTigris .

:JaguarSpecimen rdf:type mlt:TokenIndividual,
                       :PantheraOnca .

:PantheraOrganism rdf:type mlt:TokenIndividual,
                         :Organism .


