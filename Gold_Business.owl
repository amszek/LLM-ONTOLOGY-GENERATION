
@prefix :      <http://example.org/business#> .
@prefix mlt:   <http://example.org/mlt#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

#################################################################
# MLT Basic Types
#################################################################

mlt:TokenIndividual
    rdf:type owl:Class .

mlt:1stOrderClass
    rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

mlt:2ndOrderClass
    rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

mlt:3rdOrderClass
    rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

#################################################################
# MLT Properties
#################################################################

mlt:intraLevelProperty
    rdf:type owl:ObjectProperty .

mlt:crossLevelProperty
    rdf:type owl:ObjectProperty .

mlt:isSubordinateOf
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:intraLevelProperty .

mlt:isPowertypeOf
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:crossLevelProperty .

mlt:isCharacterizationOf
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:crossLevelProperty .

#################################################################
# MLT Basic-Type Relationships
#################################################################

mlt:1stOrderClass
    rdf:type mlt:2ndOrderClass ;
    mlt:isPowertypeOf mlt:TokenIndividual .

mlt:2ndOrderClass
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf mlt:1stOrderClass .

#################################################################
# Axioms
#################################################################

:EmployeeType
    rdf:type owl:Class ;
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf  mlt:1stOrderClass ;
    mlt:isPowerTypeOf    :Employee .


:BusinessRole
    rdf:type owl:Class ;
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf mlt:1stOrderClass ;
    mlt:isCharacterizationOf :Employee;
    mlt:isSubordinationOf  :EmployeeType.


:ManagementRole
    rdf:type owl:Class ;
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf mlt:1stOrderClass ;
    mlt:isCharacterizationOf :Employee;
    mlt:isSubordinationOf  :EmployeeType.


:Employee
    rdf:type owl:Class ;
    rdf:type mlt:1stOrderClass ;
    rdfs:subClassOf mlt:TokenIndividual .


:Programmer
    rdf:type owl:Class ;
    rdf:type :BusinessRole ;
    rdfs:subClassOf :Employee .

:DBDesigner
    rdf:type owl:Class ;
    rdf:type :BusinessRole ;
    rdfs:subClassOf :Employee .

:SWDesigner
    rdf:type owl:Class ;
    rdf:type :BusinessRole ;
    rdfs:subClassOf :Employee .


:Manager
    rdf:type owl:Class ;
    rdf:type :ManagementRole ;
    rdfs:subClassOf :Employee .

:Director
    rdf:type owl:Class ;
    rdf:type :ManagementRole ;
    rdfs:subClassOf :Employee .


#################################################################
# Token Individual
#################################################################

:Alice rdf:type mlt:TokenIndividual,
                :Programmer .

:Bob rdf:type mlt:TokenIndividual,
              :DBDesigner .

:Carol rdf:type mlt:TokenIndividual,
                 :Manager .

:David rdf:type mlt:TokenIndividual,
                 :Director .
