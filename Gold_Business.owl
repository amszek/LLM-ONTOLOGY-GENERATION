@prefix :      <http://example.org/business#> .
@prefix mlt:   <http://example.org/mlt#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

#################################################################
# Classes
#################################################################

:BusinessRole      rdf:type owl:Class .
:ManagementRole    rdf:type owl:Class .
:Employee          rdf:type owl:Class .
:EmployeeType    rdf:type  owl:Class.

:Programmer        rdf:type owl:Class .
:DBDesigner        rdf:type owl:Class .
:SWDesigner        rdf:type owl:Class .

:Manager           rdf:type owl:Class .
:Director          rdf:type owl:Class .

mlt:1stOrderClass    rdf:type owl:Class .
mlt:2ndOrderClass    rdf:type owl:Class .
mlt:3rdOrderClass    rdf:type owl:Class .

mlt:TokenIndividual  rdf:type owl:Class .

#################################################################
# Object Properties
#################################################################

mlt:isSubordinateOf       rdf:type owl:ObjectProperty .
mlt:isPowertypeOf         rdf:type owl:ObjectProperty .
mlt:isCharacterizationOf  rdf:type owl:ObjectProperty .

#################################################################
# Axioms
#################################################################


mlt:3rdOrderClass
    mlt:isPowertypeOf mlt:2ndOrderClass ;
    mlt:isCharacterizationOf mlt:2ndOrderClass;
    mlt:isSubordinationOf    mlt:3rdOrderClass.

mlt:2ndOrderClass
    mlt:isPowertypeOf mlt:1stOrderClass ;
    mlt:isCharacterizationOf mlt:1stOrderClass ;
     mlt:isSubordinationOf    mlt:2ndOrderClass.

:BusinessRole
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf mlt:1stOrderClass ;
    mlt:isCharacterizationOf
        :Employee;
    mlt:isSubordinationOf  :EmployeeType.


:ManagementRole
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf mlt:1stOrderClass ;
   mlt:isCharacterizationOf
        :Employee;
   mlt:isSubordinationOf  :EmployeeType.


:Employee
    rdf:type mlt:1stOrderClass.

:EmployeeType rdf:type mlt:2ndOrderClass ;
   rdfs:subClassOf  mlt:1stOrderClass ;
   mlt:isPowertypeOf    :Employee .

:Programmer
    rdf:type :BusinessRole ;
    rdfs:subClassOf :Employee .

:DBDesigner
    rdf:type :BusinessRole ;
    rdfs:subClassOf :Employee .

:SWDesigner
    rdf:type :BusinessRole ;
    rdfs:subClassOf :Employee .

:Manager
    rdf:type :ManagementRole ;
    rdfs:subClassOf :Employee .

:Director
    rdf:type :ManagementRole ;
    rdfs:subClassOf :Employee .

