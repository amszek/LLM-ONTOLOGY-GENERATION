First Attempt

@prefix : <http://example.org/panthera#> . @prefix mlt: <http://example.org/mlt#> . @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> . @prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> . @prefix owl: <http://www.w3.org/2002/07/owl#> .
:PantheraOntology rdf:type owl:Ontology .
#################################################################
MLT Core Classes
#################################################################
mlt:1stOrderClass rdf:type owl:Class .
mlt:2ndOrderClass rdf:type owl:Class .
mlt:3rdOrderClass rdf:type owl:Class .
mlt:TokenIndividual rdf:type owl:Class .
#################################################################
MLT Object Properties
#################################################################
mlt:isSubordinateOf rdf:type owl:ObjectProperty .
mlt:isPowertypeOf rdf:type owl:ObjectProperty .
mlt:isCharacterizationOf rdf:type owl:ObjectProperty .
#################################################################
MLT Meta-Level Axioms
#################################################################
mlt:3rdOrderClass mlt:isPowertypeOf mlt:2ndOrderClass ; mlt:isCharacterizationOf mlt:2ndOrderClass ; mlt:isSubordinateOf mlt:3rdOrderClass .
mlt:2ndOrderClass mlt:isPowertypeOf mlt:1stOrderClass ; mlt:isCharacterizationOf mlt:1stOrderClass ; mlt:isSubordinateOf mlt:2ndOrderClass .
#################################################################
Domain Classes
#################################################################
:TaxonomicRank rdf:type owl:Class .
:GenusType rdf:type owl:Class .
:SpeciesType rdf:type owl:Class .
:Organism rdf:type owl:Class .
:Genus rdf:type owl:Class .
:Species rdf:type owl:Class .
:Panthera rdf:type owl:Class .
:PantheraLeo rdf:type owl:Class .
:PantheraTigris rdf:type owl:Class .
:PantheraOnca rdf:type owl:Class .
#################################################################
Higher-Order Taxonomic Modelling
#################################################################
:TaxonomicRank rdf:type mlt:2ndOrderClass ; mlt:isPowertypeOf :Organism .
:GenusType rdf:type mlt:2ndOrderClass ; rdfs:subClassOf :TaxonomicRank ; mlt:isCharacterizationOf :Organism .
:SpeciesType rdf:type mlt:2ndOrderClass ; rdfs:subClassOf :TaxonomicRank ; mlt:isCharacterizationOf :Organism .
#################################################################
First-Order Classes
#################################################################
:Organism rdf:type mlt:1stOrderClass .
:Genus rdf:type mlt:1stOrderClass ; rdf:type :GenusType ; rdfs:subClassOf :Organism .
:Species rdf:type mlt:1stOrderClass ; rdf:type :SpeciesType ; rdfs:subClassOf :Organism .
#################################################################
Panthera Taxonomy
#################################################################
:Panthera rdf:type mlt:1stOrderClass ; rdf:type :GenusType ; rdfs:subClassOf :Genus .
:PantheraSpeciesType rdf:type owl:Class ; rdf:type mlt:2ndOrderClass ; rdfs:subClassOf :SpeciesType ; mlt:isSubordinateOf :GenusType ; mlt:isCharacterizationOf :Panthera .
:PantheraLeo rdf:type mlt:1stOrderClass ; rdf:type :PantheraSpeciesType ; rdfs:subClassOf :Species .
:PantheraTigris rdf:type mlt:1stOrderClass ; rdf:type :PantheraSpeciesType ; rdfs:subClassOf :Species .
:PantheraOnca rdf:type mlt:1stOrderClass ; rdf:type :PantheraSpeciesType ; rdfs:subClassOf :Species .
#################################################################
Organism Individuals
#################################################################
:LeoIndividual rdf:type owl:NamedIndividual ; rdf:type mlt:TokenIndividual ; rdf:type :PantheraLeo .
:TigrisIndividual rdf:type owl:NamedIndividual ; rdf:type mlt:TokenIndividual ; rdf:type :PantheraTigris .
:OncaIndividual rdf:type owl:NamedIndividual ; rdf:type mlt:TokenIndividual ; rdf:type :PantheraOnca .



Second Attempt
@prefix : <http://example.org/panthera#> . @prefix mlt: <http://example.org/mlt#> . @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> . @prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> . @prefix owl: <http://www.w3.org/2002/07/owl#> .
:TaxonomicRank rdf:type owl:Class .
:TaxonomicCategory rdf:type owl:Class .
:GenusType rdf:type owl:Class .
:SpeciesType rdf:type owl:Class .
:Organism rdf:type owl:Class .
:Genus rdf:type owl:Class .
:Species rdf:type owl:Class .
:Panthera rdf:type owl:Class .
:PantheraLeo rdf:type owl:Class .
:PantheraTigris rdf:type owl:Class .
:PantheraOnca rdf:type owl:Class .
mlt:1stOrderClass rdf:type owl:Class .
mlt:2ndOrderClass rdf:type owl:Class .
mlt:3rdOrderClass rdf:type owl:Class .
mlt:TokenIndividual rdf:type owl:Class .
mlt:isSubordinateOf rdf:type owl:ObjectProperty .
mlt:isPowertypeOf rdf:type owl:ObjectProperty .
mlt:isCharacterizationOf rdf:type owl:ObjectProperty .
mlt:3rdOrderClass mlt:isPowertypeOf mlt:2ndOrderClass ; mlt:isCharacterizationOf mlt:2ndOrderClass ; mlt:isSubordinateOf mlt:3rdOrderClass .
mlt:2ndOrderClass mlt:isPowertypeOf mlt:1stOrderClass ; mlt:isCharacterizationOf mlt:1stOrderClass ; mlt:isSubordinateOf mlt:2ndOrderClass .
:TaxonomicRank rdf:type mlt:2ndOrderClass ; mlt:isPowertypeOf :Organism .
:TaxonomicCategory rdf:type mlt:2ndOrderClass ; mlt:isCharacterizationOf :Organism .
:GenusType rdf:type mlt:2ndOrderClass ; rdfs:subClassOf :TaxonomicRank ; mlt:isCharacterizationOf :Organism .
:SpeciesType rdf:type mlt:2ndOrderClass ; rdfs:subClassOf :TaxonomicRank ; mlt:isCharacterizationOf :Organism .
:Organism rdf:type mlt:1stOrderClass .
:Genus rdf:type :GenusType ; rdf:type mlt:1stOrderClass ; rdfs:subClassOf :Organism .
:Species rdf:type :SpeciesType ; rdf:type mlt:1stOrderClass ; rdfs:subClassOf :Organism .
:Panthera rdf:type :Genus ; rdf:type mlt:1stOrderClass ; rdfs:subClassOf :Organism .
:PantheraLeo rdf:type :Species ; rdf:type mlt:1stOrderClass ; rdfs:subClassOf :Panthera ; mlt:isSubordinateOf :Panthera .
:PantheraTigris rdf:type :Species ; rdf:type mlt:1stOrderClass ; rdfs:subClassOf :Panthera ; mlt:isSubordinateOf :Panthera .
:PantheraOnca rdf:type :Species ; rdf:type mlt:1stOrderClass ; rdfs:subClassOf :Panthera ; mlt:isSubordinateOf :Panthera .
:LeoSpecimen1 rdf:type owl:NamedIndividual ; rdf:type :PantheraLeo ; rdf:type mlt:TokenIndividual .
:TigrisSpecimen1 rdf:type owl:NamedIndividual ; rdf:type :PantheraTigris ; rdf:type mlt:TokenIndividual .
:OncaSpecimen1 rdf:type owl:NamedIndividual ; rdf:type :PantheraOnca ; rdf:type mlt:TokenIndividual .

