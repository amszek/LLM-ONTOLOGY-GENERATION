
@prefix :      <http://example.org/person#> .
@prefix mlt:   <http://example.org/mlt#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

#################################################################
# MLT Basic Types
#################################################################

mlt:TokenIndividual rdf:type owl:Class .

mlt:1stOrderClass rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

mlt:2ndOrderClass rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

mlt:3rdOrderClass rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

#################################################################
# MLT Properties
#################################################################

mlt:intraLevelProperty rdf:type owl:ObjectProperty .
mlt:crossLevelProperty rdf:type owl:ObjectProperty .

mlt:isSubordinateOf rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:intraLevelProperty .

mlt:isPowertypeOf rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:crossLevelProperty .

mlt:isCharacterizationOf rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:crossLevelProperty .

#################################################################
# Relationships Between MLT Basic Types
#################################################################

mlt:1stOrderClass rdf:type mlt:2ndOrderClass ;
    mlt:isPowertypeOf mlt:TokenIndividual .

mlt:2ndOrderClass rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf mlt:1stOrderClass .

#################################################################
# Axioms
#################################################################

:PersonType rdf:type mlt:2ndOrderClass ;
    mlt:isPowertypeOf :Person .

:PersonTypeByGender rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf :PersonType ;
    mlt:isCharacterizationOf :Person .

:EmployeeType rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf :PersonType ;
    mlt:isCharacterizationOf :Person .

:EmployeeRoleTypeByGender rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf :EmployeeType ;
    mlt:isSubordinateOf :PersonTypeByGender .

:Person rdf:type mlt:1stOrderClass ;
    rdfs:subClassOf mlt:TokenIndividual .

:Woman rdf:type mlt:1stOrderClass, 
        rdf:type :PersonTypeByGender ;
    rdfs:subClassOf :Person .

:Man rdf:type mlt:1stOrderClass, 
     rdf:type :PersonTypeByGender ;
    rdfs:subClassOf :Person .

:Manager rdf:type mlt:1stOrderClass, 
              rdf:type :EmployeeType ;
              rdfs:subClassOf :Person .

:Researcher rdf:type mlt:1stOrderClass, 
            rdf:type :EmployeeType ;
            rdfs:subClassOf :Person .

:FemaleManager rdf:type mlt:1stOrderClass, 
               rdf:type :EmployeeRoleTypeByGender ;
               rdfs:subClassOf :Manager, 
               rdfs:subClassOf :Woman .

:MaleManager rdf:type mlt:1stOrderClass, 
             rdf:type :EmployeeRoleTypeByGender ;
             rdfs:subClassOf :Manager, 
            rdfs:subClassOf :Man .

#################################################################
# Token Individuals
#################################################################

:Ana rdf:type mlt:TokenIndividual,
              :FemaleManager .

:Bob rdf:type mlt:TokenIndividual,
              :MaleManager .
