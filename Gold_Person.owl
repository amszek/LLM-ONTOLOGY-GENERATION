@prefix :      <http://example.org/person#> .
@prefix mlt:   <http://example.org/mlt#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .


#################################################################
# Classes
#################################################################

:PersonType
    rdf:type owl:Class .

:PersonTypeByGender
    rdf:type owl:Class .

:EmployeeType
    rdf:type owl:Class .

:EmployeeRoleTypeByGender
    rdf:type owl:Class .

:Person
    rdf:type owl:Class .

:Woman
    rdf:type owl:Class .

:Man
    rdf:type owl:Class .

:Manager
    rdf:type owl:Class .

:Researcher
    rdf:type owl:Class .

:FemaleManager
    rdf:type owl:Class .

:MaleManager
    rdf:type owl:Class .

mlt:1stOrderClass
    rdf:type owl:Class .

mlt:2ndOrderClass
    rdf:type owl:Class .

mlt:3rdOrderClass
    rdf:type owl:Class .

mlt:TokenIndividual
    rdf:type owl:Class .


#################################################################
# Object Properties
#################################################################
mlt:isSubordinateOf       rdf:type owl:ObjectProperty .
mlt:isPowertypeOf         rdf:type owl:ObjectProperty .
mlt:isCharacterizationOf  rdf:type owl:ObjectProperty .

#################################################################
# Axioms
#################################################################

mlt:3rdOrderClass
    mlt:isPowertypeOf mlt:2ndOrderClass ;
    mlt:isCharacterizationOf mlt:2ndOrderClass;
    mlt:isSubordinationOf    mlt:3rdOrderClass.

mlt:2ndOrderClass
    mlt:isPowertypeOf mlt:1stOrderClass ;
    mlt:isCharacterizationOf mlt:1stOrderClass ;
    mlt:isSubordinationOf    mlt:2ndOrderClass .
  

:PersonType
    rdf:type mlt:2ndOrderClass ;
    mlt:isPowertypeOf :Person .


:PersonTypeByGender
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf :PersonType ;
    mlt:isCharacterizationOf
        :Person .


:EmployeeType
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf :PersonType ;
    mlt:isCharacterizationOf
        :Person .
        


:EmployeeRoleTypeByGender
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf :EmployeeType ;
    mlt:isSubordinateOf :PersonTypeByGender .
           
:Person
    rdf:type mlt:1stOrderClass .


:Woman
    rdf:type :PersonTypeByGender ;
    rdf:type mlt:1stOrderClass ;
    rdfs:subClassOf :Person.


:Man
    rdf:type :PersonTypeByGender ;
    rdf:type mlt:1stOrderClass ;
    rdfs:subClassOf :Person.


:Manager
    rdf:type :EmployeeType ;
    rdf:type mlt:1stOrderClass ;
    rdfs:subClassOf :Person.


:Researcher
    rdf:type :EmployeeType ;
    rdf:type mlt:1stOrderClass ;
    rdfs:subClassOf :Person.


:FemaleManager
    rdf:type :EmployeeRoleTypeByGender ;
    rdf:type mlt:1stOrderClass ;
    rdfs:subClassOf :Manager ;
    rdfs:subClassOf :Woman .


:MaleManager
    rdf:type :EmployeeRoleTypeByGender ;
    rdf:type mlt:1stOrderClass ;
    rdfs:subClassOf :Manager ;
    rdfs:subClassOf :Man .


#################################################################
# Individuals
#################################################################

:Ana
    rdf:type owl:NamedIndividual ; 
    rdf:type :FemaleManager .


:Bob
    rdf:type owl:NamedIndividual ;
       rdf:type :MaleManager .

