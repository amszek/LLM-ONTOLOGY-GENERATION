First Attempt
@prefix :	<http://example.org/PersonClassification#> .
@prefix mlt: <http://example.org/mlt#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:<http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
#################################################################
# Ontology
#################################################################
<http://example.org/PersonClassification>
	rdf:type owl:Ontology .
#################################################################
# MLT Basic Types
#################################################################
mlt:TokenIndividual
	rdf:type owl:Class .
mlt:1stOrderClass
	rdf:type owl:Class ;
	rdfs:subClassOf owl:Class .
mlt:2ndOrderClass
	rdf:type owl:Class ;
	rdfs:subClassOf owl:Class .
mlt:3rdOrderClass
	rdf:type owl:Class ;
	rdfs:subClassOf owl:Class .
#################################################################
# MLT Properties
#################################################################
mlt:intraLevelProperty
	rdf:type owl:ObjectProperty .
mlt:crossLevelProperty
	rdf:type owl:ObjectProperty .
mlt:isSubordinateOf
	rdf:type owl:ObjectProperty ;
	rdfs:subPropertyOf mlt:intraLevelProperty .
mlt:isCharacterizationOf
	rdf:type owl:ObjectProperty ;
	rdfs:subPropertyOf mlt:crossLevelProperty .
mlt:isPowertypeOf
	rdf:type owl:ObjectProperty ;
	rdfs:subPropertyOf mlt:crossLevelProperty .
#################################################################
# Domain Classes
#################################################################
:ClassificationType
	rdf:type owl:Class .
:PersonType
	rdf:type owl:Class .
:PersonTypeByGender
	rdf:type owl:Class .
:EmployeeType
	rdf:type owl:Class .
:EmployeeRoleTypeByGender
	rdf:type owl:Class .
:Person
	rdf:type owl:Class .
:Woman
	rdf:type owl:Class .
:Man
	rdf:type owl:Class .
:Manager
	rdf:type owl:Class .
:Researcher
	rdf:type owl:Class .
:FemaleManager
	rdf:type owl:Class .
:MaleManager
	rdf:type owl:Class .
#################################################################
# Powertypes
#################################################################
:PersonTypeType
	rdf:type mlt:3rdOrderClass ;
	mlt:isPowertypeOf :PersonType .
:PersonTypeByGenderType
	rdf:type mlt:3rdOrderClass ;
	mlt:isPowertypeOf :PersonTypeByGender .
:EmployeeTypeType
	rdf:type mlt:3rdOrderClass ;
	mlt:isPowertypeOf :EmployeeType .
:EmployeeRoleTypeByGenderType
	rdf:type mlt:3rdOrderClass ;
	mlt:isPowertypeOf :EmployeeRoleTypeByGender .
#################################################################
# Second-Order Classification Types
#################################################################
:PersonType
	rdf:type mlt:2ndOrderClass ;
	rdf:type :ClassificationType ;
	rdfs:subClassOf mlt:1stOrderClass ;
	mlt:isCharacterizationOf :Person .
:PersonTypeByGender
	rdf:type mlt:2ndOrderClass ;
	rdf:type :ClassificationType ;
	rdfs:subClassOf mlt:1stOrderClass ;
	mlt:isSubordinateOf :PersonType ;
	mlt:isCharacterizationOf :Person .
:EmployeeType
	rdf:type mlt:2ndOrderClass ;
	rdf:type :ClassificationType ;
	rdfs:subClassOf mlt:1stOrderClass ;
	mlt:isSubordinateOf :PersonType ;
	mlt:isCharacterizationOf :Person .
:EmployeeRoleTypeByGender
	rdf:type mlt:2ndOrderClass ;
	rdf:type :ClassificationType ;
	rdfs:subClassOf mlt:1stOrderClass ;
	mlt:isSubordinateOf :EmployeeType ;
	mlt:isCharacterizationOf :Person .
#################################################################
# First-Order Base Class
#################################################################
:Person
	rdf:type mlt:1stOrderClass ;
	rdfs:subClassOf mlt:TokenIndividual .
#################################################################
# First-Order Person Categories
#################################################################
:Woman
	rdf:type :PersonTypeByGender ;
	rdfs:subClassOf :Person .
:Man
	rdf:type :PersonTypeByGender ;
	rdfs:subClassOf :Person .
:Manager
	rdf:type :EmployeeType ;
	rdfs:subClassOf :Person .
:Researcher
	rdf:type :EmployeeType ;
	rdfs:subClassOf :Person .
:FemaleManager
	rdf:type :EmployeeRoleTypeByGender ;
	rdfs:subClassOf :Manager ;
	mlt:isCharacterizationOf :Woman .
:MaleManager
	rdf:type :EmployeeRoleTypeByGender ;
	rdfs:subClassOf :Manager ;
	mlt:isCharacterizationOf :Man .
#################################################################
# Token Individuals
#################################################################
:Ana
	rdf:type mlt:TokenIndividual ;
	rdf:type :FemaleManager ;
	rdf:type :Woman .
:Bob
	rdf:type mlt:TokenIndividual ;
	rdf:type :MaleManager ;
	rdf:type :Man .







Second Attempt
@prefix :	<http://example.org/PersonClassification#> .
@prefix mlt: <http://example.org/mlt#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
#################################################################
# Ontology
#################################################################
<http://example.org/PersonClassification>
	rdf:type owl:Ontology .
#################################################################
# MLT Basic Types
#################################################################
mlt:TokenIndividual
	rdf:type owl:Class .
mlt:1stOrderClass
	rdf:type owl:Class ;
	rdfs:subClassOf owl:Class .
mlt:2ndOrderClass
	rdf:type owl:Class ;
	rdfs:subClassOf owl:Class .
mlt:3rdOrderClass
	rdf:type owl:Class ;
	rdfs:subClassOf owl:Class .
#################################################################
# MLT Properties
#################################################################
mlt:intraLevelProperty
	rdf:type owl:ObjectProperty .
mlt:crossLevelProperty
	rdf:type owl:ObjectProperty .
mlt:isSubordinateOf
	rdf:type owl:ObjectProperty ;
	rdfs:subPropertyOf mlt:intraLevelProperty .
mlt:isCharacterizationOf
	rdf:type owl:ObjectProperty ;
	rdfs:subPropertyOf mlt:crossLevelProperty .
mlt:isPowertypeOf
	rdf:type owl:ObjectProperty ;
	rdfs:subPropertyOf mlt:crossLevelProperty .
#################################################################
# Domain Classes
#################################################################
:ClassificationType  	rdf:type owl:Class .
:PersonType          	rdf:type owl:Class .
:PersonTypeByGender  	rdf:type owl:Class .
:EmployeeType        	rdf:type owl:Class .
:EmployeeRoleTypeByGender rdf:type owl:Class .
:Person      	rdf:type owl:Class .
:Woman       	rdf:type owl:Class .
:Man         	rdf:type owl:Class .
:Manager     	rdf:type owl:Class .
:Researcher  	rdf:type owl:Class .
:FemaleManager   rdf:type owl:Class .
:MaleManager 	rdf:type owl:Class .
#################################################################
# Higher-Order Classification Types
#################################################################
:PersonTypeCategory
	rdf:type mlt:3rdOrderClass ;
	mlt:isPowertypeOf :PersonType .
:PersonTypeByGenderCategory
	rdf:type mlt:3rdOrderClass ;
	mlt:isPowertypeOf :PersonTypeByGender .
:EmployeeTypeCategory
	rdf:type mlt:3rdOrderClass ;
	mlt:isPowertypeOf :EmployeeType .
:EmployeeRoleTypeByGenderCategory
	rdf:type mlt:3rdOrderClass ;
	mlt:isPowertypeOf :EmployeeRoleTypeByGender .
#################################################################
# Second-Order Classification Types
#################################################################
:PersonType
	rdf:type mlt:2ndOrderClass ;
	rdf:type :ClassificationType ;
	rdfs:subClassOf mlt:1stOrderClass ;
	mlt:isCharacterizationOf :Person .
:PersonTypeByGender
	rdf:type mlt:2ndOrderClass ;
	rdf:type :ClassificationType ;
	rdfs:subClassOf mlt:1stOrderClass ;
	mlt:isSubordinateOf :PersonType ;
	mlt:isCharacterizationOf :Person .
:EmployeeType
	rdf:type mlt:2ndOrderClass ;
	rdf:type :ClassificationType ;
	rdfs:subClassOf mlt:1stOrderClass ;
	mlt:isSubordinateOf :PersonType ;
	mlt:isCharacterizationOf :Person .
:EmployeeRoleTypeByGender
	rdf:type mlt:2ndOrderClass ;
	rdf:type :ClassificationType ;
	rdfs:subClassOf mlt:1stOrderClass ;
	mlt:isSubordinateOf :EmployeeType ;
	mlt:isCharacterizationOf :Person .
#################################################################
# First-Order Class
#################################################################
:Person
	rdf:type mlt:1stOrderClass ;
	rdfs:subClassOf mlt:TokenIndividual .
#################################################################
# Person Classification Hierarchy
#################################################################
:Woman
	rdf:type :PersonTypeByGender ;
	rdfs:subClassOf :Person .
:Man
	rdf:type :PersonTypeByGender ;
	rdfs:subClassOf :Person .
:Manager
	rdf:type :EmployeeType ;
	rdfs:subClassOf :Person .
:Researcher
	rdf:type :EmployeeType ;
	rdfs:subClassOf :Person .
:FemaleManager
	rdf:type :EmployeeRoleTypeByGender ;
	rdfs:subClassOf :Manager ;
	mlt:isCharacterizationOf :Woman .
:MaleManager
	rdf:type :EmployeeRoleTypeByGender ;
	rdfs:subClassOf :Manager ;
	mlt:isCharacterizationOf :Man .
#################################################################
# Token Individuals
#################################################################
:Ana
	rdf:type mlt:TokenIndividual ;
	rdf:type :FemaleManager .
:Bob
	rdf:type mlt:TokenIndividual ;
	rdf:type :MaleManager .


