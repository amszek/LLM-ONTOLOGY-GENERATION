First Attempt

@prefix :	<http://example.org/CompanyMLT#> .
@prefix mlt: <http://example.org/mlt#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:<http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
#################################################################
# Ontology
#################################################################
<http://example.org/CompanyMLT>
	rdf:type owl:Ontology .
#################################################################
# MLT Basic Types
#################################################################
mlt:TokenIndividual
	rdf:type owl:Class .
mlt:1stOrderClass
	rdf:type owl:Class ;
	rdfs:subClassOf owl:Class .
mlt:2ndOrderClass
	rdf:type owl:Class ;
	rdfs:subClassOf owl:Class .
mlt:3rdOrderClass
	rdf:type owl:Class ;
	rdfs:subClassOf owl:Class .
#################################################################
# MLT Properties
#################################################################
mlt:intraLevelProperty
	rdf:type owl:ObjectProperty .
mlt:crossLevelProperty
	rdf:type owl:ObjectProperty .
mlt:isSubordinateOf
	rdf:type owl:ObjectProperty ;
	rdfs:subPropertyOf mlt:intraLevelProperty .
mlt:isCharacterizationOf
	rdf:type owl:ObjectProperty ;
	rdfs:subPropertyOf mlt:crossLevelProperty .
mlt:isPowertypeOf
	rdf:type owl:ObjectProperty ;
	rdfs:subPropertyOf mlt:crossLevelProperty .
#################################################################
# Domain Classes
#################################################################
:OrganizationalClassification
	rdf:type owl:Class .
:BusinessRole
	rdf:type owl:Class .
:ManagementRole
	rdf:type owl:Class .
:EmployeeType
	rdf:type owl:Class .
:Employee
	rdf:type owl:Class .
:Programmer
	rdf:type owl:Class .
:SoftwareDesigner
	rdf:type owl:Class .
:DatabaseDesigner
	rdf:type owl:Class .
:Manager
	rdf:type owl:Class .
:Director
	rdf:type owl:Class .
#################################################################
# Power Types (3rd Order)
#################################################################
:BusinessRoleType
	rdf:type mlt:3rdOrderClass ;
	mlt:isPowertypeOf :BusinessRole .
:ManagementRoleType
	rdf:type mlt:3rdOrderClass ;
	mlt:isPowertypeOf :ManagementRole .
:EmployeeTypeType
	rdf:type mlt:3rdOrderClass ;
	mlt:isPowertypeOf :EmployeeType .
#################################################################
# Organizational Classification Types (2nd Order)
#################################################################
:BusinessRole
	rdf:type mlt:2ndOrderClass ;
	rdf:type :OrganizationalClassification ;
	rdfs:subClassOf mlt:1stOrderClass ;
	mlt:isCharacterizationOf :Employee .
:ManagementRole
	rdf:type mlt:2ndOrderClass ;
	rdf:type :OrganizationalClassification ;
	rdfs:subClassOf mlt:1stOrderClass ;
	mlt:isCharacterizationOf :Employee .
:EmployeeType
	rdf:type mlt:2ndOrderClass ;
	rdf:type :OrganizationalClassification ;
	rdfs:subClassOf mlt:1stOrderClass ;
	mlt:isCharacterizationOf :Employee .
:ManagementRole
	mlt:isSubordinateOf :BusinessRole .
#################################################################
# First-Order Organizational Entity
#################################################################
:Employee
	rdf:type mlt:1stOrderClass ;
	rdfs:subClassOf mlt:TokenIndividual .
#################################################################
# Business Role Specializations
#################################################################
:Programmer
	rdf:type :BusinessRole ;
	rdfs:subClassOf :Employee .
:SoftwareDesigner
	rdf:type :BusinessRole ;
	rdfs:subClassOf :Employee .
:DatabaseDesigner
	rdf:type :BusinessRole ;
	rdfs:subClassOf :Employee .
#################################################################
# Management Role Specializations
#################################################################
:Manager
	rdf:type :ManagementRole ;
	rdfs:subClassOf :Employee .
:Director
	rdf:type :ManagementRole ;
	rdfs:subClassOf :Manager .
#################################################################
# Employee-Type Characterizations
#################################################################
:TechnicalEmployee
	rdf:type :EmployeeType ;
	rdfs:subClassOf :Employee ;
	mlt:isCharacterizationOf :Programmer .
:DesignEmployee
	rdf:type :EmployeeType ;
	rdfs:subClassOf :Employee ;
	mlt:isCharacterizationOf :SoftwareDesigner .
:DataEmployee
	rdf:type :EmployeeType ;
	rdfs:subClassOf :Employee ;
	mlt:isCharacterizationOf :DatabaseDesigner .
:ManagementEmployee
	rdf:type :EmployeeType ;
	rdfs:subClassOf :Employee ;
	mlt:isCharacterizationOf :Manager .
:ExecutiveEmployee
	rdf:type :EmployeeType ;
	rdfs:subClassOf :Employee ;
	mlt:isCharacterizationOf :Director .
#################################################################
# Token Individuals
#################################################################
:Alice
	rdf:type mlt:TokenIndividual ;
	rdf:type :Programmer .
:Bob
	rdf:type mlt:TokenIndividual ;
	rdf:type :SoftwareDesigner .
:Carol
	rdf:type mlt:TokenIndividual ;
	rdf:type :DatabaseDesigner .
:David
	rdf:type mlt:TokenIndividual ;
	rdf:type :Manager .
:Evelyn
	rdf:type mlt:TokenIndividual ;
	rdf:type :Director .






Second Attempt
@prefix :<http://example.org/Organization#> .
@prefix mlt: <http://example.org/mlt#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
#################################################################
# Ontology
#################################################################
:OrganizationOntology
	rdf:type owl:Ontology .
#################################################################
# MLT Basic Types
#################################################################
mlt:TokenIndividual
	rdf:type owl:Class .
mlt:1stOrderClass
	rdf:type owl:Class ;
	rdfs:subClassOf owl:Class .
mlt:2ndOrderClass
	rdf:type owl:Class ;
	rdfs:subClassOf owl:Class .
mlt:3rdOrderClass
	rdf:type owl:Class ;
	rdfs:subClassOf owl:Class .
#################################################################
# MLT Properties
#################################################################
mlt:intraLevelProperty
	rdf:type owl:ObjectProperty .
mlt:crossLevelProperty
	rdf:type owl:ObjectProperty .
mlt:isSubordinateOf
	rdf:type owl:ObjectProperty ;
	rdfs:subPropertyOf mlt:intraLevelProperty .
mlt:isCharacterizationOf
	rdf:type owl:ObjectProperty ;
	rdfs:subPropertyOf mlt:crossLevelProperty .
mlt:isPowertypeOf
	rdf:type owl:ObjectProperty ;
	rdfs:subPropertyOf mlt:crossLevelProperty .
#################################################################
# Domain Classes
#################################################################
:OrganizationalClassification
	rdf:type owl:Class .
:BusinessRole
	rdf:type owl:Class .
:ManagementRole
	rdf:type owl:Class .
:EmployeeType
	rdf:type owl:Class .
:Employee
	rdf:type owl:Class .
:Programmer
	rdf:type owl:Class .
:SoftwareDesigner
	rdf:type owl:Class .
:DatabaseDesigner
	rdf:type owl:Class .
:Manager
	rdf:type owl:Class .
:Director
	rdf:type owl:Class .
#################################################################
# Higher-Order Classification Types
#################################################################
:BusinessRoleType
	rdf:type mlt:3rdOrderClass ;
	mlt:isPowertypeOf :BusinessRole .
:ManagementRoleType
	rdf:type mlt:3rdOrderClass ;
	mlt:isPowertypeOf :ManagementRole .
:EmployeeTypeType
	rdf:type mlt:3rdOrderClass ;
	mlt:isPowertypeOf :EmployeeType .
#################################################################
# Second-Order Organizational Role Categories
#################################################################
:BusinessRole
	rdf:type mlt:2ndOrderClass ;
	rdf:type :OrganizationalClassification ;
	rdfs:subClassOf mlt:1stOrderClass ;
	mlt:isCharacterizationOf :Employee .
:ManagementRole
	rdf:type mlt:2ndOrderClass ;
	rdf:type :OrganizationalClassification ;
	rdfs:subClassOf mlt:1stOrderClass ;
	mlt:isCharacterizationOf :Employee .
:EmployeeType
	rdf:type mlt:2ndOrderClass ;
	rdf:type :OrganizationalClassification ;
	rdfs:subClassOf mlt:1stOrderClass ;
	mlt:isCharacterizationOf :Employee .
#################################################################
# First-Order Organizational Entity
#################################################################
:Employee
	rdf:type mlt:1stOrderClass ;
	rdfs:subClassOf mlt:TokenIndividual .
#################################################################
# Employee Role Types
#################################################################
:Programmer
	rdf:type :BusinessRole ;
	rdf:type :EmployeeType ;
	rdfs:subClassOf :Employee ;
	mlt:isCharacterizationOf :Employee .
:SoftwareDesigner
	rdf:type :BusinessRole ;
	rdf:type :EmployeeType ;
	rdfs:subClassOf :Employee ;
	mlt:isCharacterizationOf :Employee .
:DatabaseDesigner
	rdf:type :BusinessRole ;
	rdf:type :EmployeeType ;
	rdfs:subClassOf :Employee ;
	mlt:isCharacterizationOf :Employee .
:Manager
	rdf:type :ManagementRole ;
	rdf:type :EmployeeType ;
	rdfs:subClassOf :Employee ;
	mlt:isCharacterizationOf :Employee .
:Director
	rdf:type :ManagementRole ;
	rdf:type :EmployeeType ;
	rdfs:subClassOf :Manager ;
	mlt:isSubordinateOf :Manager ;
	mlt:isCharacterizationOf :Employee .
#################################################################
# Token Individuals
#################################################################
:Alice
	rdf:type mlt:TokenIndividual ;
	rdf:type :Programmer .
:Bob
	rdf:type mlt:TokenIndividual ;
	rdf:type :SoftwareDesigner .
:Carol
	rdf:type mlt:TokenIndividual ;
	rdf:type :DatabaseDesigner .
:David
	rdf:type mlt:TokenIndividual ;
	rdf:type :Manager .
:Evelyn
	rdf:type mlt:TokenIndividual ;
	rdf:type :Director .


