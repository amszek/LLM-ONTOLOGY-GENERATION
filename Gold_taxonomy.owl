
@prefix :    <http://example.org/Taxonomy#> .
@prefix mlt: <http://example.org/mlt#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:<http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

#################################################################
# MLT Basic Types
#################################################################

mlt:TokenIndividual
    rdf:type owl:Class .

mlt:1stOrderClass
    rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

mlt:2ndOrderClass
    rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

mlt:3rdOrderClass
    rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

#################################################################
# MLT Properties
#################################################################

mlt:intraLevelProperty
    rdf:type owl:ObjectProperty .

mlt:crossLevelProperty
    rdf:type owl:ObjectProperty .

mlt:isSubordinateOf
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:intraLevelProperty .

mlt:isCharacterizationOf
    rdf:type owl:ObjectProperty;
    rdfs:subPropertyOf mlt:crossLevelProperty .

mlt:isPowerTypeOf
    rdf:type owl:ObjectProperty;
    rdfs:subPropertyOf mlt:crossLevelProperty .


#################################################################
# Domain Classes
#################################################################

:TaxonomicRank   rdf:type owl:Class .
:Genus           rdf:type owl:Class .
:Species         rdf:type owl:Class .
:Organism        rdf:type owl:Class .
:Panthera        rdf:type owl:Class .
:PantheraSpecies rdf:type owl:Class .
:PantheraOnca    rdf:type owl:Class .
:PantheraTigris  rdf:type owl:Class .
:PantheraLeo     rdf:type owl:Class .

#################################################################
# Axioms
#################################################################

:GenusType
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf :Genus .

:SpeciesType
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf :Species .


:Genus
    rdf:type mlt:2ndOrderClass ;
    rdf:type :TaxonomicRank ;
    rdfs:subClassOf mlt:1stOrderClass ;
    mlt:isCharacterizationOf :Organism .

:Species
    rdf:type mlt:2ndOrderClass ;
    rdf:type :TaxonomicRank ;
    rdfs:subClassOf mlt:1stOrderClass ;
    mlt:isSubordinateTo :Genus ;
    mlt:isCharacterizationOf :Organism .


:Organism
    rdf:type mlt:1stOrderClass ;
    rdfs:subClassOf mlt:TokenIndividual .


:Panthera
    rdf:type :Genus ;
    rdfs:subClassOf :Organism .

:PantheraSpecies
    rdf:type :Species ;
    rdfs:subClassOf :Organism ;
    mlt:isCharacterizationOf :Panthera .

:PantheraOnca
    rdf:type :PantheraSpecies ;
    rdfs:subClassOf :Panthera .

:PantheraTigris
    rdf:type :PantheraSpecies ;
    rdfs:subClassOf :Panthera .

:PantheraLeo
    rdf:type :PantheraSpecies ;
    rdfs:subClassOf :Panthera .

#################################################################
# Token Individual
#################################################################

:Cecil
    rdf:type mlt:TokenIndividual ;
    rdf:type :PantheraLeo .
