First Attempt

@prefix :    <http://example.org/Company#> .
@prefix mlt: <http://example.org/mlt#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:<http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

#################################################################
# MLT Basic Types
#################################################################

mlt:TokenIndividual
    rdf:type owl:Class .

mlt:1stOrderClass
    rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

mlt:2ndOrderClass
    rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

mlt:3rdOrderClass
    rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

#################################################################
# MLT Properties
#################################################################

mlt:intraLevelProperty
    rdf:type owl:ObjectProperty .

mlt:crossLevelProperty
    rdf:type owl:ObjectProperty .

mlt:isSubordinateOf
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:intraLevelProperty .

mlt:isCharacterizationOf
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:crossLevelProperty .

mlt:isPowerTypeOf
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:crossLevelProperty .

#################################################################
# Domain Classes
#################################################################

:OrganizationalClassification
    rdf:type owl:Class .

:BusinessRole
    rdf:type owl:Class .

:ManagementRole
    rdf:type owl:Class .

:EmployeeType
    rdf:type owl:Class .

:Employee
    rdf:type owl:Class .

:Programmer
    rdf:type owl:Class .

:SoftwareDesigner
    rdf:type owl:Class .

:DatabaseDesigner
    rdf:type owl:Class .

:Manager
    rdf:type owl:Class .

:Director
    rdf:type owl:Class .

#################################################################
# Axioms
#################################################################

:BusinessRoleType
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowerTypeOf :BusinessRole .

:ManagementRoleType
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowerTypeOf :ManagementRole .

:EmployeeTypeType
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowerTypeOf :EmployeeType .

:BusinessRole
    rdf:type mlt:2ndOrderClass ;
    rdf:type :OrganizationalClassification ;
    rdfs:subClassOf mlt:1stOrderClass ;
    mlt:isCharacterizationOf :Employee .

:ManagementRole
    rdf:type mlt:2ndOrderClass ;
    rdf:type :OrganizationalClassification ;
    rdfs:subClassOf mlt:1stOrderClass ;
    mlt:isSubordinateOf :BusinessRole ;
    mlt:isCharacterizationOf :Employee .

:EmployeeType
    rdf:type mlt:2ndOrderClass ;
    rdf:type :OrganizationalClassification ;
    rdfs:subClassOf mlt:1stOrderClass ;
    mlt:isCharacterizationOf :Employee .

:Employee
    rdf:type mlt:1stOrderClass ;
    rdfs:subClassOf mlt:TokenIndividual .

:Programmer
    rdf:type :BusinessRole ;
    rdfs:subClassOf :Employee .

:SoftwareDesigner
    rdf:type :BusinessRole ;
    rdfs:subClassOf :Employee .

:DatabaseDesigner
    rdf:type :BusinessRole ;
    rdfs:subClassOf :Employee .

:Manager
    rdf:type :ManagementRole ;
    rdfs:subClassOf :Employee .

:Director
    rdf:type :ManagementRole ;
    rdfs:subClassOf :Employee .

#################################################################
# Token Individual
#################################################################

:Alice
    rdf:type mlt:TokenIndividual ;
    rdf:type :Manager .





Second Attempt
@prefix :    <http://example.org/Company#> .
@prefix mlt: <http://example.org/mlt#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:<http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

#################################################################
# MLT Basic Types
#################################################################

mlt:TokenIndividual
    rdf:type owl:Class .

mlt:1stOrderClass
    rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

mlt:2ndOrderClass
    rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

mlt:3rdOrderClass
    rdf:type owl:Class ;
    rdfs:subClassOf owl:Class .

#################################################################
# MLT Properties
#################################################################

mlt:intraLevelProperty
    rdf:type owl:ObjectProperty .

mlt:crossLevelProperty
    rdf:type owl:ObjectProperty .

mlt:isSubordinateOf
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf mlt:intraLevelProperty .

mlt:isCharacterizationOf
    rdf:type owl:ObjectProperty;
    rdfs:subPropertyOf mlt:crossLevelProperty .

mlt:isPowertypeOf
    rdf:type owl:ObjectProperty;
    rdfs:subPropertyOf mlt:crossLevelProperty .

#################################################################
# Domain Classes
#################################################################

:EmployeeType      rdf:type owl:Class .
:BusinessRole      rdf:type owl:Class .
:ManagementRole    rdf:type owl:Class .
:Employee          rdf:type owl:Class .
:Programmer        rdf:type owl:Class .
:SoftwareDesigner  rdf:type owl:Class .
:DatabaseDesigner  rdf:type owl:Class .
:Manager           rdf:type owl:Class .
:Director          rdf:type owl:Class .

#################################################################
# Axioms
#################################################################

:EmployeeTypeType
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf :EmployeeType .

:BusinessRoleType
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf :BusinessRole .

:ManagementRoleType
    rdf:type mlt:3rdOrderClass ;
    mlt:isPowertypeOf :ManagementRole .

:EmployeeType
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf mlt:1stOrderClass ;
    mlt:isCharacterizationOf :Employee .

:BusinessRole
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf mlt:1stOrderClass ;
    mlt:isCharacterizationOf :Employee .

:ManagementRole
    rdf:type mlt:2ndOrderClass ;
    rdfs:subClassOf mlt:1stOrderClass ;
    mlt:isSubordinateOf :BusinessRole ;
    mlt:isCharacterizationOf :Employee .

:Employee
    rdf:type mlt:1stOrderClass ;
    rdfs:subClassOf mlt:TokenIndividual .

:Programmer
    rdf:type :EmployeeType ;
    rdfs:subClassOf :Employee .

:SoftwareDesigner
    rdf:type :EmployeeType ;
    rdfs:subClassOf :Employee .

:DatabaseDesigner
    rdf:type :EmployeeType ;
    rdfs:subClassOf :Employee .

:Manager
    rdf:type :ManagementRole ;
    rdfs:subClassOf :Employee .

:Director
    rdf:type :ManagementRole ;
    rdfs:subClassOf :Employee .

#################################################################
# Token Individual
#################################################################

:Alice
    rdf:type mlt:TokenIndividual ;
    rdf:type :Programmer .


