First Attempt
@prefix : http://example.org/Company# .
@prefix mlt: http://example.org/mlt# .
@prefix rdf: http://www.w3.org/1999/02/22-rdf-syntax-ns# .
@prefix rdfs:http://www.w3.org/2000/01/rdf-schema# .
@prefix owl: http://www.w3.org/2002/07/owl# .
:OrganizationalClassificationType rdf:type owl:Class .
:BusinessRole rdf:type owl:Class .
:ManagementRole rdf:type owl:Class .
:EmployeeType rdf:type owl:Class .
:Employee rdf:type owl:Class .
:Programmer rdf:type owl:Class .
:SoftwareDesigner rdf:type owl:Class .
:DatabaseDesigner rdf:type owl:Class .
:Manager rdf:type owl:Class .
:Director rdf:type owl:Class .
:BusinessRoleType rdf:type owl:Class .
:ManagementRoleType rdf:type owl:Class .
:EmployeeRoleType rdf:type owl:Class .
mlt:1stOrderClass rdf:type owl:Class .
mlt:2ndOrderClass rdf:type owl:Class .
mlt:3rdOrderClass rdf:type owl:Class .
mlt:TokenIndividual rdf:type owl:Class .
mlt:isSubordinateOf rdf:type owl:ObjectProperty .
mlt:isPowertypeOf rdf:type owl:ObjectProperty .
mlt:isCharacterizationOf rdf:type owl:ObjectProperty .
mlt:3rdOrderClass
mlt:isPowertypeOf mlt:2ndOrderClass ;
mlt:isCharacterizationOf mlt:2ndOrderClass ;
mlt:isSubordinateOf mlt:3rdOrderClass .
mlt:2ndOrderClass
mlt:isPowertypeOf mlt:1stOrderClass ;
mlt:isCharacterizationOf mlt:1stOrderClass ;
mlt:isSubordinateOf mlt:2ndOrderClass .
:BusinessRoleType
rdf:type mlt:3rdOrderClass ;
mlt:isPowertypeOf :BusinessRole .
:ManagementRoleType
rdf:type mlt:3rdOrderClass ;
mlt:isPowertypeOf :ManagementRole .
:EmployeeRoleType
rdf:type mlt:3rdOrderClass ;
mlt:isPowertypeOf :EmployeeType .
:BusinessRole
rdf:type mlt:2ndOrderClass ;
rdf:type :OrganizationalClassificationType .
:ManagementRole
rdf:type mlt:2ndOrderClass ;
rdf:type :OrganizationalClassificationType ;
mlt:isSubordinateOf :BusinessRole .
:EmployeeType
rdf:type mlt:2ndOrderClass ;
rdf:type :OrganizationalClassificationType ;
mlt:isCharacterizationOf :Employee .
:Employee
rdf:type mlt:1stOrderClass ;
rdfs:subClassOf mlt:TokenIndividual .
:Programmer
rdf:type :EmployeeType ;
rdfs:subClassOf :Employee .
:SoftwareDesigner
rdf:type :EmployeeType ;
rdfs:subClassOf :Employee .
:DatabaseDesigner
rdf:type :EmployeeType ;
rdfs:subClassOf :Employee .
:Manager
rdf:type :ManagementRole ;
rdf:type :EmployeeType ;
rdfs:subClassOf :Employee ;
mlt:isCharacterizationOf :Employee .
:Director
rdf:type :ManagementRole ;
rdf:type :EmployeeType ;
rdfs:subClassOf :Employee ;
mlt:isSubordinateOf :Manager ;
mlt:isCharacterizationOf :Employee .
:Alice
rdf:type owl:NamedIndividual ;
rdf:type :Programmer .
:Bob
rdf:type owl:NamedIndividual ;
rdf:type :Manager .
:Carol
rdf:type owl:NamedIndividual ;
rdf:type :Director .





Second Attempt

@prefix : http://example.org/Company# .
@prefix mlt: http://example.org/mlt# .
@prefix rdf: http://www.w3.org/1999/02/22-rdf-syntax-ns# .
@prefix rdfs:http://www.w3.org/2000/01/rdf-schema# .
@prefix owl: http://www.w3.org/2002/07/owl# .
#################################################################
Classes
#################################################################
:OrganizationalClassificationType rdf:type owl:Class .
:BusinessRole rdf:type owl:Class .
:ManagementRole rdf:type owl:Class .
:EmployeeType rdf:type owl:Class .
:Employee rdf:type owl:Class .
:Programmer rdf:type owl:Class .
:SoftwareDesigner rdf:type owl:Class .
:DatabaseDesigner rdf:type owl:Class .
:Manager rdf:type owl:Class .
:Director rdf:type owl:Class .
:BusinessRoleType rdf:type owl:Class .
:ManagementRoleType rdf:type owl:Class .
:EmployeeRoleType rdf:type owl:Class .
mlt:1stOrderClass rdf:type owl:Class .
mlt:2ndOrderClass rdf:type owl:Class .
mlt:3rdOrderClass rdf:type owl:Class .
mlt:TokenIndividual rdf:type owl:Class .
#################################################################
Object Properties
#################################################################
mlt:isSubordinateOf rdf:type owl:ObjectProperty .
mlt:isPowertypeOf rdf:type owl:ObjectProperty .
mlt:isCharacterizationOf rdf:type owl:ObjectProperty .
#################################################################
Axioms
#################################################################
mlt:3rdOrderClass
mlt:isPowertypeOf mlt:2ndOrderClass ;
mlt:isCharacterizationOf mlt:2ndOrderClass ;
mlt:isSubordinateOf mlt:3rdOrderClass .
mlt:2ndOrderClass
mlt:isPowertypeOf mlt:1stOrderClass ;
mlt:isCharacterizationOf mlt:1stOrderClass ;
mlt:isSubordinateOf mlt:2ndOrderClass .
:OrganizationalClassificationType
rdf:type mlt:2ndOrderClass .
:BusinessRoleType
rdf:type mlt:3rdOrderClass ;
mlt:isPowertypeOf :BusinessRole .
:ManagementRoleType
rdf:type mlt:3rdOrderClass ;
mlt:isPowertypeOf :ManagementRole .
:EmployeeRoleType
rdf:type mlt:3rdOrderClass ;
mlt:isPowertypeOf :EmployeeType .
:BusinessRole
rdf:type mlt:2ndOrderClass ;
rdf:type :OrganizationalClassificationType .
:ManagementRole
rdf:type mlt:2ndOrderClass ;
rdf:type :OrganizationalClassificationType ;
mlt:isSubordinateOf :BusinessRole .
:EmployeeType
rdf:type mlt:2ndOrderClass ;
rdf:type :OrganizationalClassificationType ;
mlt:isCharacterizationOf :Employee .
:Employee
rdf:type mlt:1stOrderClass ;
rdfs:subClassOf mlt:TokenIndividual .
:Programmer
rdf:type :EmployeeType ;
rdfs:subClassOf :Employee ;
mlt:isCharacterizationOf :Employee .
:SoftwareDesigner
rdf:type :EmployeeType ;
rdfs:subClassOf :Employee ;
mlt:isCharacterizationOf :Employee .
:DatabaseDesigner
rdf:type :EmployeeType ;
rdfs:subClassOf :Employee ;
mlt:isCharacterizationOf :Employee .
:Manager
rdf:type :EmployeeType ;
rdf:type :ManagementRole ;
rdfs:subClassOf :Employee ;
mlt:isCharacterizationOf :Employee ;
mlt:isSubordinateOf :Director .
:Director
rdf:type :EmployeeType ;
rdf:type :ManagementRole ;
rdfs:subClassOf :Employee ;
mlt:isCharacterizationOf :Employee .
#################################################################
Individuals
#################################################################
:Alice
rdf:type owl:NamedIndividual ;
rdf:type :Programmer .
:Bob
rdf:type owl:NamedIndividual ;
rdf:type :SoftwareDesigner .
:Carol
rdf:type owl:NamedIndividual ;
rdf:type :DatabaseDesigner .
:Dave
rdf:type owl:NamedIndividual ;
rdf:type :Manager .
:Eve
rdf:type owl:NamedIndividual ;
rdf:type :Director .

